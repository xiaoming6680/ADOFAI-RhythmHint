<Project Sdk="Microsoft.NET.Sdk">
  <!-- 游戏路径：在仓库根目录的 local.props 里写 GameDir（见 local.props.example），
       或设环境变量 ADOFAI_DIR。游戏的 DLL 只在本机引用，不进仓库。 -->
  <Import Project="..\..\local.props" Condition="Exists('..\..\local.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RhythmHint</AssemblyName>
    <RootNamespace>RhythmHint</RootNamespace>
    <ModId>RhythmHint</ModId>
    <GameDir Condition="'$(GameDir)' == ''">$(ADOFAI_DIR)</GameDir>
    <ManagedDir>$(GameDir)\A Dance of Fire and Ice_Data\Managed</ManagedDir>
    <ModDeployDir>$(GameDir)\Mods\$(ModId)</ModDeployDir>
    <!-- 仓库地址只写这一处：Info.json 的 HomePage、Repository 和更新清单里的下载地址都由它拼出 -->
    <RepoUrl>https://github.com/xiaoming6680/ADOFAI-RhythmHint</RepoUrl>
    <!-- Repository：UMM 启动时读的更新清单，指向最新一个 Release 里的 Repository.json（GitHub 会跳转到那个 Release）。
         在游戏里试提示时可用 -p:ModRepository=file:///D:/…/Repository.json 指向本地假清单；打发布包时不许改 -->
    <DefaultModRepository>$(RepoUrl)/releases/latest/download/Repository.json</DefaultModRepository>
    <ModRepository Condition="'$(ModRepository)' == ''">$(DefaultModRepository)</ModRepository>
    <!-- 自动更新的国内加速镜像（2026-11-19：国内很多玩家连不上 GitHub，用户选了加速镜像站）：前缀 + 完整的 GitHub 地址，分号隔开。
         清单同时问 GitHub 和每个镜像，压缩包按这个顺序换着下；SHA-256 照样核对。镜像站是第三方，失效了改这里，
         改之前用 curl 试一下 前缀 + releases/latest/download/update.json（见 docs/开发说明.md「更新提示」） -->
    <UpdateMirrors>https://ghfast.top/;https://edgeone.gh-proxy.org/;https://ghproxy.net/</UpdateMirrors>
    <!-- 装进游戏的都是测试版（用户要求）：版本号带 -dev，在 UMM 列表和「关于」里一眼和发布版分开。
         UMM 解析版本时去掉非数字，1.3.0-dev 当作 1.3.0，检查更新不受影响。要装不带后缀的加 -p:VersionSuffix= -->
    <VersionSuffix Condition="'$(Deploy)' == 'true' and '$(VersionSuffix)' == ''">dev</VersionSuffix>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core 的源码直接编进本 DLL，游戏里只需要一个文件 -->
    <Compile Include="..\RhythmHint.Core\**\*.cs" Exclude="..\RhythmHint.Core\bin\**;..\RhythmHint.Core\obj\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 镜像列表编进程序集元数据，AutoUpdater 运行时读（Info.json 是 UMM 的格式，不往里加字段） -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateMirrors</_Parameter1>
      <_Parameter2>$(UpdateMirrors)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- 手序编辑器（网页，src/RhythmHint.Editor）随 Mod 装进 Mods/RhythmHint/Editor：游戏里一键打开。
         session.js、session-audio* 是游戏运行时写的，测试样例在 tests 里，都不打包 -->
    <EditorFile Include="..\RhythmHint.Editor\*.html;..\RhythmHint.Editor\*.css;..\RhythmHint.Editor\*.js;..\RhythmHint.Editor\icon.ico" Exclude="..\RhythmHint.Editor\session.js;..\RhythmHint.Editor\session-audio*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 翻译表（键是中文原文）编进 DLL -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="RhythmHint.Languages.%(Filename).json" />
    <!-- 难度徽章：TUF 的 P1–U20 图标（CC BY 4.0，署名见 DifficultyIcons/README.md）编进 DLL -->
    <EmbeddedResource Include="DifficultyIcons\*.png" LogicalName="RhythmHint.DifficultyIcons.%(Filename).png" />
    <!-- 设置窗口（F8）的线条图标：白色 64 像素 PNG，绘制时染色。源文件 SettingsIcons/icons.svg，用 tools/make-settings-icons.py 生成 -->
    <EmbeddedResource Include="SettingsIcons\*.png" LogicalName="RhythmHint.SettingsIcons.%(Filename).png" />
  </ItemGroup>

  <ItemGroup>
    <!-- netstandard 也用游戏自带的（2.1）：Unity 6 的模块按 2.1 编译，.NET Framework 参考程序集里只有 2.0。
         UnityEngine.UI / UIModule：设置窗口底下的透明挡板（InputShield）用；Newtonsoft.Json：读翻译表 -->
    <GameReference Include="Assembly-CSharp;Assembly-CSharp-firstpass;RDTools;UnityEngine;UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.TextRenderingModule;UnityEngine.InputLegacyModule;UnityEngine.AudioModule;UnityEngine.ImageConversionModule;UnityEngine.UIModule;UnityEngine.UI;UnityEngine.UnityWebRequestModule;Newtonsoft.Json;netstandard" />
    <Reference Include="@(GameReference)">
      <HintPath>$(ManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(ManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 自动更新解压发布包（Core 的 ModUpdate）：.NET Framework 自带，游戏的 Managed 里也有 System.IO.Compression.dll -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="找不到游戏文件：$(ManagedDir)\Assembly-CSharp.dll。请复制 local.props.example 为 local.props 并填写 GameDir，或设置环境变量 ADOFAI_DIR。" />
    <Error Condition="!Exists('$(ManagedDir)\UnityModManager\UnityModManager.dll')"
           Text="游戏里还没装 Unity Mod Manager（找不到 $(ManagedDir)\UnityModManager\UnityModManager.dll）。" />
  </Target>

  <!-- UMM 的 Info.json：版本号取自 Directory.Build.props，只有一个来源。
       作者也只写在这里，设置窗口「关于」从 Mod.Info 读 -->
  <Target Name="WriteInfoJson" AfterTargets="Build">
    <PropertyGroup>
      <InfoJsonText>{
  "Id": "$(ModId)",
  "DisplayName": "全节奏提示 RhythmHint",
  "Author": "XIAOMING6680",
  "Version": "$(Version)",
  "HomePage": "$(RepoUrl)",
  "Repository": "$(ModRepository)",
  "ManagerVersion": "0.27.0",
  "AssemblyName": "$(AssemblyName).dll",
  "EntryMethod": "RhythmHint.Main.Load"
}</InfoJsonText>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)Info.json" Lines="$(InfoJsonText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- dotnet build -c Release -p:UmmPackage=true：在仓库根目录 artifacts\ 生成 UMM 可直接安装的 RhythmHint-版本.zip。
       压缩包里是 RhythmHint/RhythmHint.dll、RhythmHint/Info.json（UMM 识别 Info.json 所在的文件夹）和手序编辑器 RhythmHint/Editor/。
       用 MSBuild 的 ZipDirectory：路径分隔符是标准的「/」。0.9.1 用 Windows PowerShell 5.1 的 Compress-Archive 打包，
       路径是「RhythmHint\Info.json」，不是标准 zip 路径，安装器可能认不出。
       同时生成 UMM 的更新清单 artifacts\Repository.json，发 Release 时和压缩包一起上传：
       游戏里的 UMM 读它提示新版本，UMM 安装器 Mods 页右键可按其中的 DownloadUrl 一键更新。
       还生成 Mod 自动更新用的 artifacts\update.json（版本、地址、压缩包的 SHA-256，见 Core 的 ModUpdate），也一起上传；
       再复制一份 CHANGELOG.md 到 artifacts\（2026-11-19 用户：夸克网盘里也放一份更新记录）。
       带后缀的测试包（-p:VersionSuffix=dev）只打压缩包、不写这些，免得覆盖发版用的清单。正式包先过 CheckReleasePackage -->
  <Target Name="PackageForUmm" AfterTargets="WriteInfoJson" DependsOnTargets="CheckReleasePackage" Condition="'$(UmmPackage)' == 'true'">
    <Error Condition="'$(ModRepository)' != '$(DefaultModRepository)'"
           Text="打发布包时不能改 ModRepository（现在是 $(ModRepository)），否则玩家收不到更新提示。" />
    <PropertyGroup>
      <!-- 试自动更新时可用 -p:PackageOutDir=别的文件夹 打一个假的新版本，不碰 artifacts 里发版用的清单 -->
      <ArtifactsDir Condition="'$(PackageOutDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(PackageOutDir)'))</ArtifactsDir>
      <ArtifactsDir Condition="'$(PackageOutDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'artifacts'))</ArtifactsDir>
      <PackageStageDir>$(ArtifactsDir)stage\</PackageStageDir>
      <PackageZip>$(ArtifactsDir)$(ModId)-$(Version).zip</PackageZip>
      <ReleasePackage Condition="'$(VersionSuffix)' == ''">true</ReleasePackage>
      <PackageUrl>$(RepoUrl)/releases/download/v$(Version)/$(ModId)-$(Version).zip</PackageUrl>
      <RepositoryJsonText>{
  "Releases": [
    {
      "Id": "$(ModId)",
      "Version": "$(Version)",
      "DownloadUrl": "$(PackageUrl)"
    }
  ]
}</RepositoryJsonText>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)Info.json" DestinationFolder="$(PackageStageDir)$(ModId)" />
    <Copy SourceFiles="@(EditorFile)" DestinationFolder="$(PackageStageDir)$(ModId)\Editor" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <RemoveDir Directories="$(PackageStageDir)" />
    <GetFileHash Files="$(PackageZip)" Algorithm="SHA256" HashEncoding="hex" Condition="'$(ReleasePackage)' == 'true'">
      <Output TaskParameter="Hash" PropertyName="PackageSha256" />
    </GetFileHash>
    <PropertyGroup Condition="'$(ReleasePackage)' == 'true'">
      <UpdateJsonText>{
  "format": "rhythmhint-update",
  "version": "$(Version)",
  "url": "$(PackageUrl)",
  "sha256": "$(PackageSha256.ToLowerInvariant())"
}</UpdateJsonText>
    </PropertyGroup>
    <WriteLinesToFile File="$(ArtifactsDir)Repository.json" Lines="$(RepositoryJsonText)" Overwrite="true" Condition="'$(ReleasePackage)' == 'true'" />
    <WriteLinesToFile File="$(ArtifactsDir)update.json" Lines="$(UpdateJsonText)" Overwrite="true" Condition="'$(ReleasePackage)' == 'true'" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\CHANGELOG.md" DestinationFolder="$(ArtifactsDir)" Condition="'$(ReleasePackage)' == 'true'" />
    <Message Importance="high" Condition="'$(ReleasePackage)' == 'true'" Text="已打包 $(PackageZip)；Repository.json、update.json、CHANGELOG.md 在 $(ArtifactsDir)" />
    <Message Importance="high" Condition="'$(ReleasePackage)' != 'true'" Text="已打包测试包 $(PackageZip)（不写更新清单）" />
  </Target>

  <!-- 正式包（不带后缀、打进 artifacts）打包前检查，免得传错包。2026-11-19 评审：版本号还是已发布的 1.3.1 时打包，
       静默生成了同版本号、内容不同的 RhythmHint-1.3.1.zip 和新的 update.json；传上去的话装着 1.3.1 的玩家不会更新，SHA-256 也和线上的包对不上。
       1. 两份更新记录都要有本版本一节（## 版本 · 日期）
       2. 两份更新记录的「未发布」「Unreleased」下不能还有条目：有就是还没分到版本号的改动
       3. 本地有这个版本的 git 标签（发过 Release 并拉取过）时，src 和 Directory.Build.props（打进包里的东西）要和标签时一模一样
          （没提交的改动、没加进 git 的新文件也算），才允许重打；标签要等 GitHub 上建 Release 才有，新版本第一次打包不受影响。
          没有 .git（源码压缩包）时跳过这一条
       带后缀的测试包、-p:PackageOutDir 打到别处的包（试自动更新用的假新版）不检查 -->
  <Target Name="CheckReleasePackage" Condition="'$(VersionSuffix)' == '' and '$(PackageOutDir)' == ''">
    <PropertyGroup>
      <ReleaseRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</ReleaseRepoRoot>
      <ReleaseNotesZh>$([System.IO.File]::ReadAllText('$(ReleaseRepoRoot)CHANGELOG.md'))</ReleaseNotesZh>
      <ReleaseNotesEn>$([System.IO.File]::ReadAllText('$(ReleaseRepoRoot)CHANGELOG.en.md'))</ReleaseNotesEn>
      <ReleaseHeading>(?m)^## $(Version.Replace('.', '\.')) · \d{4}-\d{2}-\d{2}[ \t]*(?:\r?\n|\z)</ReleaseHeading>
      <!-- 未发布一节里（到下一个 ## 标题为止）有列表项 -->
      <UnreleasedItems>(?m)^## (?:未发布|Unreleased)[ \t]*\r?\n(?:(?!## ).*\r?\n)*?[ \t]*[-*+][ \t]+\S</UnreleasedItems>
      <ReleaseNotesOk>$([System.Text.RegularExpressions.Regex]::IsMatch($(ReleaseNotesZh), $(ReleaseHeading)))</ReleaseNotesOk>
      <ReleaseNotesOk Condition="'$(ReleaseNotesOk)' == 'True'">$([System.Text.RegularExpressions.Regex]::IsMatch($(ReleaseNotesEn), $(ReleaseHeading)))</ReleaseNotesOk>
      <UnreleasedLeft>$([System.Text.RegularExpressions.Regex]::IsMatch($(ReleaseNotesZh), $(UnreleasedItems)))</UnreleasedLeft>
      <UnreleasedLeft Condition="'$(UnreleasedLeft)' != 'True'">$([System.Text.RegularExpressions.Regex]::IsMatch($(ReleaseNotesEn), $(UnreleasedItems)))</UnreleasedLeft>
    </PropertyGroup>
    <Error Condition="'$(ReleaseNotesOk)' != 'True'"
           Text="CHANGELOG.md 和 CHANGELOG.en.md 都要有 $(Version) 这一节（标题写成 ## $(Version) · 日期）才能打正式包。发版时把未发布、Unreleased 改成这个标题；只是测试就加 -p:VersionSuffix=dev。" />
    <Error Condition="'$(UnreleasedLeft)' == 'True'"
           Text="更新记录的未发布、Unreleased 下还有条目，这些改动还没有版本号，打出来的包会顶着已有的 $(Version)。先改 Directory.Build.props 的 VersionPrefix，把两份更新记录的未发布改成 ## 新版本 · 日期，再打正式包；只是测试就加 -p:VersionSuffix=dev。" />

    <Exec Command="git tag --list v$(Version)" WorkingDirectory="$(ReleaseRepoRoot)" Condition="Exists('$(ReleaseRepoRoot).git')"
          ConsoleToMSBuild="true" EchoOff="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ReleaseTag" />
      <Output TaskParameter="ExitCode" PropertyName="ReleaseTagExit" />
    </Exec>
    <PropertyGroup>
      <ReleaseTagged Condition="'$(ReleaseTagExit)' == '0' and '$(ReleaseTag)' == 'v$(Version)'">true</ReleaseTagged>
    </PropertyGroup>
    <!-- 退出码 0 = 和标签时一样，1 = 有不同（已提交的、没提交的都算） -->
    <Exec Command="git diff --quiet v$(Version) -- src Directory.Build.props" WorkingDirectory="$(ReleaseRepoRoot)" Condition="'$(ReleaseTagged)' == 'true'"
          EchoOff="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="ReleaseChanged" />
    </Exec>
    <Exec Command="git ls-files --others --exclude-standard -- src" WorkingDirectory="$(ReleaseRepoRoot)" Condition="'$(ReleaseTagged)' == 'true'"
          ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ReleaseUntracked" />
    </Exec>
    <Error Condition="'$(ReleaseTagged)' == 'true' and ('$(ReleaseChanged)' != '0' or '$(ReleaseUntracked)' != '')"
           Text="$(Version) 已经发布过（有 git 标签 v$(Version)），现在的 src 或 Directory.Build.props 和标签时不一样：同一个版本号装着不同内容，已装 $(Version) 的玩家收不到更新，update.json 的 SHA-256 也和线上的包对不上。先改 Directory.Build.props 的 VersionPrefix 和两份更新记录；确实要重打已发布的版本，要让 src 和标签 v$(Version) 时完全一样。" />
    <Message Importance="high" Condition="'$(ReleaseTagged)' == 'true'"
             Text="注意：$(Version) 已经发布过，这次是在标签 v$(Version) 上重打。压缩包的 SHA-256 通常和已发布的不同，压缩包和 update.json 要么一起重新上传，要么都不传。" />
  </Target>

  <!-- dotnet build -p:Deploy=true：编译后复制到游戏的 Mods 目录（不碰已有的 Settings.xml、手序文件夹和编辑器运行时写的 session 文件） -->
  <Target Name="DeployToGame" AfterTargets="WriteInfoJson" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb;$(OutDir)Info.json" DestinationFolder="$(ModDeployDir)" />
    <Copy SourceFiles="@(EditorFile)" DestinationFolder="$(ModDeployDir)\Editor" />
    <Message Importance="high" Text="已复制到 $(ModDeployDir)" />
  </Target>
</Project>
